                  "p": 0.8
                }
              },
              "cost_usd": 0.001
            }
          ],
          "expect": {
            "body": {
              "status": "ok"
            },
            "log": [
              {
                "entry": "conf-logfull",
                "set_hash": "c561c35a",
                "status": "ok",
                "state": {
                  "text": "CANARY-7f3a"
                },
                "answers": {
                  "flag": {
                    "p": 0.8
                  }
                }
              }
            ]
          }
