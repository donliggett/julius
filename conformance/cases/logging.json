{
  "suite": "julius-conformance",
  "julius": "0.1",
  "group": "logging",
  "cases": [
    {
      "id": "log-answers",
      "section": "4",
      "description": "log: answers stores answers and metadata, not state.",
      "steps": [
        {
          "request": {
            "path": "/v1/decide",
            "client_ip": "203.0.113.10",
            "headers": {
              "Authorization": "Bearer k-conf-private"
            },
            "body": {
              "entry": "conf-private",
              "set": "nobands",
              "state": {
                "text": "CANARY-7f3a"
              },
              "request_id": "log-1"
            }
          },
          "responses": [
            {
              "answers": {
                "flag": {
                  "p": 0.8
                }
              },
              "cost_usd": 0.001
            }
          ],
          "expect": {
            "body": {
              "status": "ok"
            },
            "log": [
              {
                "entry": "conf-private",
                "set": "nobands",
                "set_hash": "8fb117e8",
                "status": "ok",
                "request_id": "log-1",
                "answers": {
                  "flag": {
                    "p": 0.8
                  }
                },
                "state": {
                  "$absent": true
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "log-full",
      "section": "4",
      "description": "log: full stores state as sent, plus answers.",
