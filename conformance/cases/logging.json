    },
    {
      "id": "log-none",
      "section": "4",
      "description": "log: none stores metadata only.",
      "steps": [
        {
          "request": {
            "path": "/v1/decide",
            "client_ip": "203.0.113.10",
            "headers": {
              "Authorization": "Bearer k-conf-lognone"
            },
            "body": {
              "entry": "conf-lognone",
              "set": "check",
              "state": {
                "text": "CANARY-7f3a"
