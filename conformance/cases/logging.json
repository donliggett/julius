    {
      "id": "log-failure",
      "section": "4",
      "description": "A provider failure is logged with its status and reason.",
      "steps": [
        {
          "request": {
            "path": "/v1/decide",
            "client_ip": "203.0.113.10",
            "headers": {
              "Authorization": "Bearer k-conf-private"
            },
            "body": {
              "entry": "conf-private",
              "set": "nobands",
              "state": {
                "text": "I'd like my money back"
              }
            }
          },
          "responses": [
            {
              "error": "timeout"
            }
          ],
          "expect": {
            "body": {
              "status": "unavailable"
            },
            "log": [
              {
                "entry": "conf-private",
                "set": "nobands",
                "set_hash": "8fb117e8",
                "status": "unavailable",
                "reason": "provider_timeout",
                "answers": {
                  "$absent": true
                }
              }
            ]
          }
        }
      ]
    }
  ]
