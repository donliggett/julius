    {
      "id": "hash-shared-equals-inline",
      "section": "8",
      "description": "$shared options hash the same as the same options written inline.",
      "steps": [
        {
          "request": {
            "path": "/v1/decide",
            "client_ip": "203.0.113.10",
            "headers": {
              "Authorization": "Bearer k-conf-inline"
            },
            "body": {
              "entry": "conf-inline",
              "set": "shared-set",
              "state": {
                "text": "The green button"
              }
            }
          },
          "responses": [
            {
              "answers": {
                "pick": {
                  "probs": {
                    "red": 0.1,
                    "green": 0.8,
                    "blue": 0.1
