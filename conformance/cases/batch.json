    {
      "id": "batch-order-and-ids",
      "section": "6",
      "description": "One envelope per item, in request order, each with its id.",
      "steps": [
        {
          "request": {
            "path": "/v1/decide/batch",
            "client_ip": "203.0.113.10",
            "headers": {
              "Authorization": "Bearer k-conf-private"
            },
            "body": {
              "entry": "conf-private",
              "set": "nobands",
              "items": [
                {
                  "id": "b",
                  "state": "one"
                },
                {
                  "id": "a",
                  "state": "two"
                }
              ]
            }
          },
          "responses": [
            {
              "answers": {
                "flag": {
                  "p": 0.1
                }
              },
              "cost_usd": 0.001
            },
            {
              "answers": {
                "flag": {
                  "p": 0.9
                }
              },
              "cost_usd": 0.001
            }
          ],
          "expect": {
            "body": {
              "status": "ok",
              "julius": "0.1",
              "entry": "conf-private",
              "set": "nobands",
              "results": [
                {
                  "id": "b",
                  "status": "ok",
                  "answers": {
                    "flag": {
                      "p": 0.1
                    }
                  },
                  "set_hash": "8fb117e8"
                },
                {
                  "id": "a",
                  "status": "ok",
                  "answers": {
                    "flag": {
                      "p": 0.9
                    }
                  }
                }
              ]
            },
            "provider_calls": 2
          }
        }
      ]
    },
    {
      "id": "batch-item-bad-params",
      "section": "6",
      "description": "A bad item fails on its own; the others are answered.",
      "steps": [
        {
          "request": {
            "path": "/v1/decide/batch",
            "client_ip": "203.0.113.10",
            "headers": {
              "Authorization": "Bearer k-conf-private"
            },
            "body": {
              "entry": "conf-private",
              "set": "route",
              "items": [
                {
                  "id": "x",
                  "state": {
                    "body": "Checkout page times out after the last deploy."
                  },
                  "params": {
                    "teams": []
                  }
                },
                {
                  "id": "y",
                  "state": {
                    "body": "Checkout page times out after the last deploy."
                  },
                  "params": {
                    "teams": [
                      {
                        "id": "t1",
                        "name": "Payments",
                        "size": 4
                      },
                      {
                        "id": "t2",
                        "name": "Search",
                        "size": 7
                      }
                    ]
                  }
                }
              ]
            }
          },
          "responses": [
            {
              "answers": {
                "owns.t1": {
                  "p": 0.9
                },
                "owns.t2": {
                  "p": 0.05
                },
                "tagged.t1": {
                  "p": 0.3
                },
                "tagged.t2": {
                  "p": 0.2
                },
                "severe": {
                  "p": 0.6
                }
              },
              "cost_usd": 0.001
            }
          ],
          "expect": {
            "body": {
              "status": "ok",
              "results": [
                {
                  "id": "x",
                  "status": "rejected",
                  "reason": "bad_params",
                  "answers": {
                    "$absent": true
                  }
                },
                {
                  "id": "y",
                  "status": "ok"
                }
              ]
            },
            "provider_calls": 1
          }
        }
      ]
    },
    {
      "id": "batch-budget-runs-out",
      "section": "6",
      "description": "Spend reaches the limit partway through; later items are over_budget.",
      "steps": [
        {
          "request": {
            "path": "/v1/decide/batch",
