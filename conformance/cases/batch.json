                  "p": 0.5
                }
              },
              "cost_usd": 0.25
            },
            {
              "answers": {
                "flag": {
                  "p": 0.5
                }
              },
              "cost_usd": 0.25
            }
          ],
          "expect": {
            "body": {
              "status": "ok",
              "results": [
                {
                  "id": "i1",
                  "status": "ok"
                },
                {
                  "id": "i2",
                  "status": "ok"
                },
                {
                  "id": "i3",
                  "status": "over_budget",
                  "reason": "entry_budget"
                }
              ]
            },
            "provider_calls": 2
          }
        }
      ]
    },
