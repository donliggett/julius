    {
      "id": "state-too-large",
      "section": "7",
      "description": "State over the provider's size limit is rejected, and the error doesn't echo the state.",
      "provider": {
        "max_state_chars": 200
      },
      "steps": [
        {
          "request": {
            "path": "/v1/decide",
            "client_ip": "203.0.113.10",
            "headers": {
              "Authorization": "Bearer k-conf-private"
            },
            "body": {
              "entry": "conf-private",
              "set": "nobands",
              "state": {
                "text": "CANARY-7f3a "
              }
            }
          },
          "expect": {
            "body": {
              "status": "rejected",
              "julius": "0.1",
              "reason": "state_too_large",
