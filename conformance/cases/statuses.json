              "answers": {
                "$absent": true
              },
              "band": {
                "$absent": true
              },
              "entry": "conf-private",
              "set": "nobands"
            },
            "body_excludes": [
              "CANARY-7f3a"
            ],
            "provider_calls": 0
          }
        }
      ]
    },
    {
      "id": "killed-entry",
      "section": "7",
      "description": "A switched-off entry returns over_budget / killed without calling the provider.",
