{
  "suite": "julius-conformance",
  "julius": "0.1",
  "group": "statuses",
  "cases": [
    {
      "id": "bad-request-invalid-json",
      "section": "7",
      "description": "A body that isn't JSON is rejected.",
      "steps": [
        {
          "request": {
            "path": "/v1/decide",
            "client_ip": "203.0.113.10",
            "headers": {
              "Authorization": "Bearer k-conf-private"
            },
            "raw_body": "{not json"
          },
          "expect": {
            "body": {
              "status": "rejected",
              "reason": "bad_request",
              "julius": "0.1"
            },
            "provider_calls": 0
          }
        }
      ]
    },
    {
      "id": "bad-request-missing-state",
      "section": "6",
      "description": "state is required.",
      "steps": [
        {
          "request": {
            "path": "/v1/decide",
            "client_ip": "203.0.113.10",
            "headers": {
              "Authorization": "Bearer k-conf-private"
            },
            "body": {
              "entry": "conf-private",
              "set": "triage"
            }
          },
          "expect": {
            "body": {
              "status": "rejected",
              "julius": "0.1",
              "reason": "bad_request",
              "ms": {
                "$type": "number"
              },
              "request_id": {
                "$type": "string"
              },
              "answers": {
                "$absent": true
              },
              "band": {
                "$absent": true
              },
              "entry": "conf-private",
              "set": "triage"
            },
            "provider_calls": 0
          }
        }
      ]
    },
