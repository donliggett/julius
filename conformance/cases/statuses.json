              "set": "nobands",
              "state": {
                "text": "I'd like my money back"
              }
            }
          },
          "expect": {
            "body": {
              "status": "over_budget",
              "julius": "0.1",
              "reason": "killed",
              "ms": {
                "$type": "number"
              },
              "request_id": {
