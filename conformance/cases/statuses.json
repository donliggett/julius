              "set": "check",
              "state": {
                "text": "I'd like my money back"
              }
            }
          },
          "responses": [
            {
              "answers": {
                "flag": {
                  "p": 0.8
                }
              },
              "cost_usd": 0.001
            }
          ],
          "expect": {
            "body": {
              "status": "ok",
              "calibrated": false,
              "answers": {
