    {
      "id": "uncalibrated-accepted",
      "section": "10",
      "description": "An entry with accept_uncalibrated: true gets answers marked calibrated: false.",
      "provider": {
        "calibrated": false
      },
      "steps": [
        {
          "request": {
            "path": "/v1/decide",
            "client_ip": "203.0.113.10",
            "headers": {
