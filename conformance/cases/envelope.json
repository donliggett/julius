  "cases": [
    {
      "id": "ok-envelope",
      "section": "7",
      "description": "A successful response carries every envelope field, derived choice/level/label, and the band.",
      "steps": [
        {
          "request": {
            "path": "/v1/decide",
            "client_ip": "203.0.113.10",
            "headers": {
              "Authorization": "Bearer k-conf-private"
            },
            "body": {
              "entry": "conf-private",
              "set": "triage",
              "state": {
                "title": "Export fails",
                "body": "CSV export returns an empty file since Monday."
              },
              "request_id": "req-1"
            }
          },
          "responses": [
            {
              "answers": {
                "kind": {
                  "probs": {
                    "bug": 0.2,
                    "feature": 0.7,
                    "other": 0.1
                  },
                  "confidence": 0.9
                },
                "urgency": {
                  "score": 1.4,
                  "confidence": 0.8
                },
                "risky": {
                  "p": 0.1
                }
              },
              "cost_usd": 0.001
            }
          ],
          "expect": {
            "body": {
              "status": "ok",
              "julius": "0.1",
              "entry": "conf-private",
              "set": "triage",
              "set_hash": "790222de",
              "provider": "mock",
              "model": "mock-model-1",
              "calibrated": true,
              "ms": {
                "$type": "number"
              },
              "request_id": "req-1",
              "band": "go",
              "answers": {
                "kind": {
                  "choice": "feature",
                  "probs": {
                    "bug": 0.2,
                    "feature": 0.7,
                    "other": 0.1
                  },
                  "confidence": 0.9
                },
                "urgency": {
                  "score": 1.4,
                  "level": 1,
                  "label": "Today",
                  "confidence": 0.8
                },
                "risky": {
                  "p": 0.1
                }
              }
            },
            "provider_calls": [
              {
                "model": "mock-model-1",
                "state": {
                  "title": "Export fails",
                  "body": "CSV export returns an empty file since Monday."
                },
                "questions": [
                  {
                    "id": "kind",
                    "type": "choice",
                    "instructions": "What kind of report this is",
                    "options": [
                      "bug",
                      "feature",
                      "other"
                    ]
                  },
                  {
                    "id": "urgency",
                    "type": "score",
                    "instructions": "How soon someone needs to look at it",
                    "levels": [
                      "This week",
                      "Today",
                      "Now"
                    ]
                  },
                  {
                    "id": "risky",
                    "type": "yesno",
                    "instructions": "The report describes lost or corrupted data",
                    "if_true": "Data is gone, wrong, or unreadable"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
