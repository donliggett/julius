    {
      "id": "private-ignores-origin",
      "section": "4",
      "description": "A private entry with a valid key works whatever the Origin.",
      "steps": [
        {
          "request": {
            "path": "/v1/decide",
            "client_ip": "203.0.113.10",
            "headers": {
              "Authorization": "Bearer k-conf-private",
              "Origin": "https://evil.example"
            },
            "body": {
              "entry": "conf-private",
              "set": "nobands",
              "state": {
                "text": "I'd like my money back"
              }
            }
          },
          "responses": [
            {
              "answers": {
                "flag": {
                  "p": 0.2
                }
              },
              "cost_usd": 0.001
            }
          ],
          "expect": {
